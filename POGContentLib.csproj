<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>POGContentLib</RootNamespace>
    <AssemblyName>POGContentLib</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The folder that holds MelonLoader\net6 and MelonLoader\Il2CppAssemblies. The default assumes
         this project sits at <game>\ModSource\POGContentLib; override with -p:GameDir=... (for a Gale
         profile: -p:GameDir=~/.local/share/com.kesomannen.gale/pit-of-goblin/profiles/Default). -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..</GameDir>
    <MelonDir>$(GameDir)\MelonLoader\net6</MelonDir>
    <InteropDir>$(GameDir)\MelonLoader\Il2CppAssemblies</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/ holds separate projects (runtime driver, unit tests); keep their sources out of the library. -->
    <Compile Remove="tests/**" />
    <Compile Remove="samples/**" />
    <None Remove="tests/**" />
    <None Remove="samples/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(InteropDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(InteropDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(InteropDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(InteropDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ParticleSystem: read by VisualProbe when reporting an item's glow/pulse setup. -->
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(InteropDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(InteropDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(InteropDir)\Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- IMGUI + legacy input + physics raycasts: the shop dev tools. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(InteropDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(InteropDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(InteropDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(InteropDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TextMeshPro: shop price tags (ShopLocation.m_priceTagText). -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(InteropDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(InteropDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(InteropDir)\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Steam lobby metadata: the channel the multiplayer parity layer uses. -->
    <Reference Include="Il2CppFacepunch.Steamworks.Win64">
      <HintPath>$(InteropDir)\Il2CppFacepunch.Steamworks.Win64.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Game.Platform.SteamRuntimeManager (lobby callbacks the parity layer patches). The game moved
         it out of Assembly-CSharp into its own SteamCommon assembly in the 2026-11-06 update. -->
    <Reference Include="Il2CppSteamCommon">
      <HintPath>$(InteropDir)\Il2CppSteamCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
